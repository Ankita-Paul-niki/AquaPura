# AquaPura frontend — environment variable template
#
# Copy this file to .env.local and adjust for your environment.
# .env.local is gitignored and should never be committed.
#
# During local development the Vite proxy (vite.config.js) forwards
# all /api/* requests to http://localhost:8000, so VITE_API_BASE_URL
# can be left empty or omitted entirely.
#
# In production (e.g. a deployed server), set this to the full URL
# of your deployed FastAPI backend:
#   VITE_API_BASE_URL=https://api.yourdeployment.example.com

VITE_API_BASE_URL=
