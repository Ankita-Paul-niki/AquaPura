# ----------------------------------------------
# AquaPura � .gitignore
# ----------------------------------------------

# -- Environment & secrets ----------------------
.env
.env.local
.env.*.local

# -- Python -------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# -- ML artifacts -------------------------------
ml/models/*.pkl
# ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/reports/*.png
ml/reports/*.pdf

# -- Dataset ------------------------------------
# Keep folder structure; ignore actual data files
dataset/raw/*
dataset/processed/*
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep

# -- Node / Frontend ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# -- SQLite database ----------------------------
*.db
*.sqlite
*.sqlite3

# -- OS / Editor --------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# -- Logs ---------------------------------------
*.log
logs/


.env.production