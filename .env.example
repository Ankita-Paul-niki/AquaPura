# ──────────────────────────────────────────────
# AquaPura — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Backend / API ──────────────────────────────

# Port that Uvicorn listens on (default 8000)
BACKEND_PORT=8000

# Allowed CORS origins (comma-separated, no spaces)
# Example: http://localhost:5173,https://aquapura.example.com
CORS_ORIGINS=http://localhost:5173

# Secret key used for signing tokens (generate a random 32-byte hex string)
SECRET_KEY=replace_with_a_random_secret_key

# ── Database ───────────────────────────────────

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./aquapura.db

# ── Machine Learning ───────────────────────────

# Path to the serialised model artifact (relative to backend/)
MODEL_PATH=../ml/models/water_quality_model.joblib

# ── Chatbot / LLM ─────────────────────────────
# Uncomment and fill in when the chatbot feature is implemented.

# Provider: openai | watsonx | anthropic
# LLM_PROVIDER=openai

# OpenAI
# OPENAI_API_KEY=sk-replace_with_your_openai_key
# OPENAI_MODEL=gpt-4o-mini

# IBM watsonx.ai
# WATSONX_API_KEY=replace_with_your_watsonx_key
# WATSONX_PROJECT_ID=replace_with_your_project_id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Frontend (Vite) ───────────────────────────
# Variables MUST be prefixed with VITE_ to be exposed to the browser.

# Base URL of the backend API (used by Vite dev proxy and production builds)
VITE_API_BASE_URL=http://localhost:8000
